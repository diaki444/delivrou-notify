# Copiez ce fichier en .env sur le VPS (cp .env.example .env) puis remplissez-le.
# .env est deja dans .gitignore : ne le committez jamais.

# Interrupteur d'urgence : passez a "true" pour suspendre TOUT envoi et
# toute connexion WhatsApp (tableau de bord et numero lie), par exemple le
# temps de reconfigurer le bon numero apres une erreur. Le tableau de bord
# reste accessible en lecture, mais plus aucun message ne part ni n'arrive.
# Remettez a "false" (ou supprimez la ligne) puis redemarrez pour reprendre.
WHATSAPP_DISABLED=false

# Cle secrete partagee avec le backend delivrou.com (header x-notify-key).
# Generez-en une longue et aleatoire, ex: openssl rand -hex 32
NOTIFY_SECRET=

# Mot de passe du tableau de bord web (/dashboard) : conversations, envoi
# manuel, journal des envois. Laissez vide pour desactiver le tableau de
# bord. Choisissez un mot de passe solide, different de NOTIFY_SECRET.
DASHBOARD_PASSWORD=

# Port d'ecoute interne du service (Nginx fera reverse-proxy dessus).
PORT=3300

# Delai minimum entre deux envois WhatsApp, en millisecondes.
WHATSAPP_MIN_DELAY_MS=1500

# --- Garde-fous anti-blocage WhatsApp (valeurs par defaut raisonnables,
# ajustables selon votre volume reel) ---

# Pas plus d'un message au MEME numero dans cet intervalle (ms).
WHATSAPP_PER_RECIPIENT_COOLDOWN_MS=10000

# Nombre maximum de messages envoyes, toutes destinations confondues, par
# minute glissante.
WHATSAPP_MAX_PER_MINUTE=20

# Nombre maximum de messages envoyes par jour (reinitialise a minuit UTC).
WHATSAPP_MAX_PER_DAY=500

# Apres ce nombre d'echecs d'envoi consecutifs, le service suspend
# automatiquement les envois (protection si WhatsApp commence a refuser).
WHATSAPP_CIRCUIT_FAILURE_THRESHOLD=5

# Duree de la suspension automatique en cas de coupe-circuit (ms).
WHATSAPP_CIRCUIT_COOLDOWN_MS=300000

# Cle API Google Places (New), pour la recherche automatique d'etablissements
# dans l'onglet Prospection. Voir le README pour la creer. Laissez vide pour
# desactiver la recherche (le reste du tableau de bord continue de marcher).
GOOGLE_PLACES_API_KEY=

# Cle API Google Gemini (offre gratuite), pour : (1) generer un message de
# prospection par famille de commerce, (2) suggerer un brouillon de reponse
# quand un prospect/client ecrit (jamais envoye automatiquement, toujours
# relu et confirme manuellement). Creez une cle gratuite sur
# https://aistudio.google.com/apikey . Laissez vide pour desactiver : les
# modeles de message par defaut restent utilisables sans IA.
GEMINI_API_KEY=
